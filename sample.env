DOCKER_NETWORK=stacks
NETWORK=mainnet
## Services `docker compose up -d` starts: always node and api (API + postgres), plus any of signer,
## proxy (Caddy) and monitoring. Signer: add signer and set the signer private key below.
COMPOSE_PROFILES=node,api
## Data location (default ./persistent-data/<network>/<component>). Point DATA_ROOT, or a single
## component, at a dedicated disk or mount.
# DATA_ROOT=./persistent-data
# STACKS_DATA_DIR=
# POSTGRES_DATA_DIR=
# SIGNER_DATA_DIR=
## Seed job (docker compose run --rm seed): where archives are downloaded / looked for, restore parallelism
# SEED_DOWNLOAD_DIR=./persistent-data/seed-downloads
# SEED_RESTORE_JOBS=8
# SEED_CONNECTIONS=4
# SEED_PG_MAINTENANCE_MEM=1GB
## Indexes to build after the stack starts instead of during the restore (mainnet: the hash index
## nft_events_asset_identifier_index takes hours to rebuild); the build-indexes job builds them
# SEED_DEFER_INDEXES=nft_events_asset_identifier_index
## Exposure: everything is reachable from this host only, except the node's P2P port (public, for
## peers). To serve the API to other machines, add `proxy` to COMPOSE_PROFILES (nginx, see below).
## Metrics, Prometheus and Grafana are never published beyond this host.
# API_BIND_ADDR=127.0.0.1
# RPC_BIND_ADDR=127.0.0.1
## Postgres is reachable only inside the stack (the API is its only client). POSTGRES_LOCAL=1 publishes it
## on 127.0.0.1:POSTGRES_LOCAL_PORT for local tools; it is never published beyond this host.
# POSTGRES_LOCAL=1
# POSTGRES_LOCAL_PORT=5432
## P2P: the default assumes the node is behind NAT. It connects out to peers and accepts none from the
## internet. If peers can reach this host on the P2P port (STACKS_CORE_P2P_PORT, forwarded on the router,
## or a public IP), set the address they use, so the node advertises it (docs/requirements.md#behind-nat).
# STACKS_P2P_ADDRESS=203.0.113.7:20444
## sbd ui: judge "synced" against a public API's tip (within 15 blocks) instead of the age of the
## latest block. Off by default: the dashboard makes no outbound calls unless this is set.
# SBD_UI_REFERENCE_API=https://api.hiro.so

###############################
## Stacks Signer
##
AUTH_TOKEN=1234
SIGNER_PRIVATE_KEY=
TESTNET_SIGNER_PRIVATE_KEY=
STACKS_SIGNER_PORT=30000
SIGNER_METRICS_PORT=9154

###############################
## Stacks Blockchain API
##
NODE_ENV=production
GIT_TAG=master
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=postgres
PG_SCHEMA=public
PG_SHMSIZE=256MB
STACKS_CHAIN_ID_DEFAULT=2147483648
V2_POX_MIN_AMOUNT_USTX=90000000260
STACKS_CORE_EVENT_PORT=3700
STACKS_CORE_EVENT_HOST=0.0.0.0
STACKS_BLOCKCHAIN_API_PORT=3999
STACKS_BLOCKCHAIN_API_HOST=0.0.0.0
STACKS_BLOCKCHAIN_API_DB=pg
STACKS_CORE_RPC_HOST=stacks-blockchain
STACKS_CORE_RPC_PORT=20443
STACKS_CORE_P2P_PORT=20444
# STACKS_API_ENABLE_FT_METADATA=1
# STACKS_API_ENABLE_NFT_METADATA=1
# STACKS_API_TOKEN_METADATA_ERROR_MODE=warning
# STACKS_ADDRESS_CACHE_SIZE=10000
# BNS_IMPORT_DIR=/bns-data

###############################
## Stacks Blockchain
##
RUST_BACKTRACE=full
STACKS_LOG_DEBUG=0
STACKS_LOG_JSON=0
NODE_METRICS_PORT=9153
# STACKS_EVENT_OBSERVER=stacks-blockchain-api:3700
## Timeout for event delivery to the API observer; the node retries with up to 3x this backoff
# API_OBSERVER_TIMEOUT_MS=60000
##
## How long to wait for stacks-blockchain event loop to stop (default is 20 minutes)
##    The event-observer run loop can take quite a long time to stop processing
##    ** if you kill this thread before it's done, it can cause a corrupt chainstate **
STACKS_SHUTDOWN_TIMEOUT=1200

###############################
## Monitoring (opt in: add `monitoring` to COMPOSE_PROFILES)
## Prometheus and Grafana listen on 127.0.0.1 only (use an SSH tunnel from elsewhere).
## Grafana needs an admin password.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
## How often Prometheus scrapes the node, API and signer (infrastructure exporters stay at 30s)
# PROMETHEUS_APP_SCRAPE_INTERVAL=15s
## Alert notifications through Grafana (off by default). Needs a contact point: a webhook and/or email
# MONITORING_ALERTS=1
# GRAFANA_ALERT_WEBHOOK_URL=https://ntfy.sh/<topic>
# GRAFANA_ALERT_EMAIL=ops@example.org
## SMTP for email alerts (host:port)
# GRAFANA_SMTP_HOST=smtp.example.org:587
# GRAFANA_SMTP_USER=
# GRAFANA_SMTP_PASSWORD=
# GRAFANA_SMTP_FROM=grafana@example.org
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=
## 1 = on, 0 = off (numbers, not true/false)
MONITORING_GRAFANA=1
MONITORING_CONTAINER_METRICS=1
# PROMETHEUS_VERSION=v3.15.0
# GRAFANA_VERSION=13.0.2
# CADVISOR_VERSION=v0.55.1
# NODE_EXPORTER_VERSION=v1.12.1
# POSTGRES_EXPORTER_VERSION=v0.20.1

###############################
## Proxy (the `proxy` profile, Caddy): serves the API to other machines, on all interfaces by default.
## HTTP only unless PROXY_TLS=1, which adds HTTPS on PROXY_HTTPS_PORT and redirects HTTP to it:
##   with PROXY_DOMAIN, a Let's Encrypt certificate (the name must point at this host, and ports 80 and
##   443 be reachable from the internet: forward them behind NAT); without it, a self-signed one.
##
# PROXY_BIND_ADDR=0.0.0.0
# PROXY_HTTP_PORT=80
## keep 443 with PROXY_TLS=1: the HTTP-to-HTTPS redirect and Let's Encrypt both use the standard port
# PROXY_HTTPS_PORT=443
# PROXY_TLS=1
# PROXY_DOMAIN=api.example.org
## optional: Let's Encrypt's contact for expiry warnings
# PROXY_ACME_EMAIL=ops@example.org
# CADDY_VERSION=2.11.9-alpine

###############################
## Docker image versions
##
## The seed job (docker compose run --rm seed, sbd seed or scripts/seed-chainstate.sh) picks the newest
## Hiro archive snapshot compatible with these pins (an older snapshot is migrated on first start)
STACKS_BLOCKCHAIN_VERSION=4.0.7
STACKS_SIGNER_VERSION=4.0.7
STACKS_BLOCKCHAIN_API_VERSION=9.10.0
# version of the postgres image to use
POSTGRES_VERSION=17

## Mainnet Defaults
## Follow your own Bitcoin node if at all possible (BTC_HOST, BTC_P2P_PORT): the default public peer serves
## many Stacks nodes and often turns connections away, so syncs from it are slow (the node retries).
## Only P2P is used; a follower needs no RPC credentials.
BTC_HOST=bitcoin.mainnet.stacks.org
# A follower node needs no bitcoind RPC credentials (only a miner would, which this repo doesn't run).
# Set these only if your bitcoind requires them; empty values leave them out of the node config.
# BTC_RPC_USER=
# BTC_RPC_PASS=
BTC_RPC_PORT=8332
BTC_P2P_PORT=8333

## Testnet Defaults
TBTC_HOST=bitcoin.regtest.hiro.so
TBTC_RPC_PORT=18443
TBTC_P2P_PORT=18444
